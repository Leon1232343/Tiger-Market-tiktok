{
  "name": "tiger-market-jarvis",
  "version": "1.0.0",
  "description": "AI Social Media Intelligence Command Center for Tiger Market",
  "main": "dist/server/index.js",
  "scripts": {
    "build": "tsc --project tsconfig.server.json && cd src/client && npm install && npm run build",
    "build:server": "tsc --project tsconfig.server.json",
    "build:client": "cd src/client && npm install && npm run build",
    "start": "node dist/server/index.js",
    "dev": "tsx watch src/server/index.ts",
    "prisma:generate": "npx prisma generate",
    "prisma:migrate": "npx prisma migrate dev",
    "prisma:push": "npx prisma db push",
    "prisma:seed": "tsx prisma/seed.ts",
    "db:studio": "npx prisma studio"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "node-cron": "^3.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "axios": "^1.7.9",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@prisma/cli": "5.22.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.1",
    "@types/node-cron": "^3.0.11",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "5.22.0",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.2"
  }
}
