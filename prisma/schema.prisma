datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Trend {
  id               String        @id @default(uuid())
  name             String
  type             String        // sound, meme, format, challenge, etc.
  status           String        // EXPLODING, RISING, ACTIVE, ESTABLISHED, DECLINING, DEAD
  platform         String        // tiktok, youtube, instagram, reddit, twitter, google
  growthSignal     Float         // 0-1 score
  viralityScore    Float         // 0-1 score
  tigerRelevance   Float         // 0-1 score
  competitionLevel Float         // 0-1 score
  estimatedAge     Int           // hours
  expectedLifespan Int           // hours
  whyTrending      String
  currentUsage     String
  exampleVideos    String        // JSON stringified array
  soundLink        String?
  sourceLinks      String        // JSON stringified array
  detectedAt       DateTime      @default(now())
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  contentIdeas     ContentIdea[] @relation("TrendIdea")
}

model ContentIdea {
  id               String             @id @default(uuid())
  title            String
  contentType      String             // Meme, Promotion, Trend, Comparison, POV, Ragebait, Community
  advertising      String             // Low, Medium, High
  trendScore       Int                // 0-100
  virality         Int                // 0-100
  tigerRelevance   Int                // 0-100
  difficulty       String             // Easy, Medium, Hard
  duration         String             // e.g., "12-15 seconds"
  descriptionDe    String             // German description
  whyNowDe         String             // German why it works now
  howToMakeDe      String             // German instructions
  onScreenConcept  String             // English
  captionEn        String             // English caption
  hashtagsEn       String             // English hashtags
  soundLink        String?
  inspirationLinks String             // JSON stringified array
  status           String             @default("NEW") // NEW, APPROVED, REJECTED, POSTED, ARCHIVED
  trendId          String?
  trend            Trend?             @relation("TrendIdea", fields: [trendId], references: [id], onDelete: SetNull)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  scheduledContent ScheduledContent[] @relation("ScheduledIdea")
}

model Competitor {
  id            String   @id @default(uuid())
  username      String   @unique
  platform      String   // tiktok, instagram, youtube, twitter
  displayName   String?
  bio           String?
  followerCount Int?
  isApproved    Boolean  @default(false)
  isPaused      Boolean  @default(false)
  discoveredAt  DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model BrandCommentOpportunity {
  id                String   @id @default(uuid())
  videoUrl          String
  platform          String
  title             String?
  description       String?
  viewCount         Int?
  likeCount         Int?
  commentCount      Int?
  shareCount        Int?
  brandAccounts     String   // JSON stringified array
  suggestedComments String   // JSON stringified array
  detectedAt        DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model UserFeedback {
  id         String   @id @default(uuid())
  type       String   // IDEA, COMMENT, TREND, CATEGORY, COMPETITOR
  entityId   String
  entityType String
  action     String   // APPROVED, REJECTED, RATED_UP, RATED_DOWN
  notes      String?
  createdAt  DateTime @default(now())
}

model ContentCategory {
  id             String   @id @default(uuid())
  name           String   @unique // e.g., "Fake Corporate Ads"
  description    String
  examples       String   // JSON stringified array
  tigerPotential String
  isApproved     Boolean  @default(false)
  discoveredAt   DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ScheduledContent {
  id            String      @id @default(uuid())
  contentIdeaId String
  contentIdea   ContentIdea @relation("ScheduledIdea", fields: [contentIdeaId], references: [id], onDelete: Cascade)
  scheduledFor  DateTime
  postedAt      DateTime?
  platform      String?
  status        String      @default("PLANNED") // PLANNED, POSTED, SKIPPED
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model BufferAnalytics {
  id              String   @id @default(uuid())
  platform        String   // tiktok
  postId          String   @unique
  views           Int?
  likes           Int?
  comments        Int?
  shares          Int?
  saves           Int?
  followersGained Int?
  watchTime       Int?     // seconds
  completionRate  Float?   // 0-1
  postedAt        DateTime
  syncedAt        DateTime @default(now())
}

model UserIdea {
  id             String   @id @default(uuid())
  originalIdea   String
  aiImprovements String?
  relatedTrends  String   // JSON stringified array
  variations     String   // JSON stringified array
  status         String   @default("NEW") // NEW, PROCESSED, APPROVED, ARCHIVED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model WhatWorksInsight {
  id             String   @id @default(uuid())
  insight        String
  category       String   // content_type, timing, advertising, duration, etc.
  confidence     Float    // 0-1
  sampleSize     Int
  supportingData String?  // JSON stringified object
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
